# AWS Configuration
aws_region = "us-east-1"
project_name = "growthbook"

# Network Configuration
vpc_cidr = "10.0.0.0/16"
az_count = 2

# ECS Configuration
docker_image = "growthbook/growthbook:latest"
task_cpu = 2048      # 2 vCPU
task_memory = 4096   # 4 GB
desired_count = 2
min_capacity = 2
max_capacity = 10
cpu_target_value = 70.0
memory_target_value = 80.0

# MongoDB Configuration
# Use AWS DocumentDB, MongoDB Atlas, or self-hosted MongoDB
# Example: mongodb://username:password@docdb-cluster.xxxxx.docdb.amazonaws.com:27017/growthbook?ssl=true&replicaSet=rs0&readPreference=secondaryPreferred&retryWrites=false
mongodb_uri = "mongodb://user:password@host:27017/growthbook"

# Secrets (leave empty to auto-generate)
jwt_secret = ""
encryption_key = ""

# Application URLs
# For production, use your actual domain names
app_origin = "https://growthbook.example.com"
api_host = "https://api.growthbook.example.com"
frontend_domain = "growthbook.example.com"
backend_domain = "api.growthbook.example.com"

# SSL Certificate (optional, leave empty for HTTP only)
# Get this from AWS Certificate Manager after creating a certificate
acm_certificate_arn = ""

# Logging
log_retention_days = 7

# ALB Configuration
enable_deletion_protection = false

# Additional environment variables (optional)
# additional_environment_variables = [
#   {
#     name  = "EMAIL_ENABLED"
#     value = "true"
#   },
#   {
#     name  = "EMAIL_HOST"
#     value = "smtp.example.com"
#   }
# ]

