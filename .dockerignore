# Git
.git
.gitignore
.gitattributes

# CI/CD
.github
.gitlab-ci.yml
.travis.yml

# Documentation (large directory)
docs
*.md
!README.md
CODE_OF_CONDUCT.md
SECURITY.md
CONTRIBUTING.md
CODEBUILD-SETUP.md

# Docker
docker-compose*.yml
Dockerfile*
.dockerignore

# Development
.vscode
.idea
*.swp
*.swo
*~
*.code-workspace

# Node modules (will be installed in container)
node_modules
**/node_modules

# Build outputs (will be built in container)
dist
build
.next
**/dist
**/build
**/.next
**/.cache
**/coverage
**/.nyc_output

# Test files (but allow Python tests in stats package)
**/*.test.ts
**/*.test.tsx
**/*.spec.ts
**/*.spec.tsx
**/test
**/tests
**/__tests__
coverage
.nyc_output
# Allow tests in packages/stats (needed for poetry build)
!packages/stats/tests

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Environment files
.env
.env.local
.env.*.local
.env.development
.env.production

# OS files
.DS_Store
Thumbs.db
*.swp
*.swo

# Terraform and AWS config (not needed for build)
aws-deployment
aws-config
*.tfstate
*.tfstate.*
.terraform
*.tfvars

# Charts (not needed for build)
charts

# Large image/video files (keep only front-end public assets)
*.png
*.jpg
*.jpeg
*.gif
*.svg
*.webp
*.mp4
*.pdf
!packages/front-end/public/**/*.png
!packages/front-end/public/**/*.svg
!packages/front-end/public/**/*.jpg
!packages/front-end/public/**/*.jpeg
!packages/front-end/public/**/*.gif
!packages/front-end/public/**/*.webp

# Screenshots and large files
features-screenshot.png
growthbook-screenshot.png

# Plop templates (not needed for build)
plop-templates

# TypeScript build info (will be generated)
*.tsbuildinfo
**/*.tsbuildinfo

# Source maps (will be generated)
*.map
**/*.map

# Python cache
__pycache__
*.pyc
*.pyo
*.pyd
.Python
*.so
*.egg
*.egg-info
.pytest_cache
.mypy_cache

# Additional exclusions for large directories
packages/back-end/test
packages/front-end/test
packages/sdk-js/test
packages/sdk-react/test
packages/shared/test

